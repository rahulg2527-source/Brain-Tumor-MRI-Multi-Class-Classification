def count_images(split):
    counts = {}
    for cls in CLASS_NAMES:
        folder = DATASET_ROOT / split / cls
        counts[cls] = sum(1 for p in folder.rglob('*') if p.suffix.lower() in IMAGE_EXTS) if folder.exists() else 0
    return counts

